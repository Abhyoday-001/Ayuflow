# Google Cloud Platform (GCP) Config
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=ayucarez-medical-documents-private

# Local Development Credentials (Optional if using Workload Identity in Prod)
# Provide the absolute path to your Service Account JSON key for local dev
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account.json

# Database Config
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/ayucarez
